
pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Terraform Init') {
            steps {
                dir('terraform') {
                    sh 'terraform init'
                }
            }
        }

        stage('Terraform Format Check') {
            steps {
                dir('terraform') {
                    sh 'terraform fmt -check'
                }
            }
        }

        stage('Terraform Validate') {
            steps {
                dir('terraform') {
                    sh 'terraform validate'
                }
            }
        }

        stage('Terraform Plan') {
            steps {
                withCredentials([string(
                    credentialsId: 'terraform-ssh-allowed-cidr',
                    variable: 'TF_VAR_ssh_allowed_cidr'
                )]) {
                    dir('terraform') {
                        sh '''
                            terraform plan \
                                -input=false \
                                -out=shopsphere.tfplan

                            terraform show -no-color shopsphere.tfplan
                        '''

                        archiveArtifacts(
                            artifacts: 'shopsphere.tfplan',
                            fingerprint: true
                        )
                    }
                }
            }
        }
    }

    post {
        success {
            echo 'Terraform pipeline completed successfully.'
            echo 'Saved Terraform plan as a Jenkins artifact.'
        }

        failure {
            echo 'Terraform pipeline failed. Check the console output.'
        }
    }
}
