
pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Terraform Init') {
            steps {
                dir('terraform') {
                    sh 'terraform init'
                }
            }
        }

        stage('Terraform Format Check') {
            steps {
                dir('terraform') {
                    sh 'terraform fmt -check'
                }
            }
        }

        stage('Terraform Validate') {
            steps {
                dir('terraform') {
                    sh 'terraform validate'
                }
            }
        }

        stage('Terraform Plan') {
            steps {
                withCredentials([string(
                    credentialsId: 'terraform-ssh-allowed-cidr',
                    variable: 'TF_VAR_ssh_allowed_cidr'
                )]) {
                    dir('terraform') {
                        sh '''
                            terraform plan \
                                -input=false \
                                -out=shopsphere.tfplan

                            terraform show -no-color shopsphere.tfplan
                        '''

                        archiveArtifacts(
                            artifacts: 'shopsphere.tfplan',
                            fingerprint: true
                        )
                    }
                }
            }
        }

        stage('Manual Approval') {
            steps {
                script {
                    input(
                        message: 'Review the Terraform plan. Approve to continue?',
                        ok: 'Approve Infrastructure Deployment'
                    )
                }
            }
        }

        stage('Terraform Apply') {
            steps {
                dir('terraform') {
                    sh '''
                        terraform apply \
                            -input=false \
                            -auto-approve \
                            shopsphere.tfplan
                    '''
                }
            }
        }
    }

    post {
        success {
            echo 'Terraform infrastructure pipeline completed successfully.'
        }

        failure {
            echo 'Terraform infrastructure pipeline failed.'
        }

        aborted {
            echo 'Terraform infrastructure pipeline was aborted.'
        }
    }
}
